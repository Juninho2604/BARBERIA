{
  "name": "barberia",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "find-my-way": "^9.7.0",
      "postcss": "^8.5.29",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
